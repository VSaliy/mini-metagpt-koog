# Copy to .env and export (e.g. `set -a; . ./.env; set +a`). Never commit .env.
LLM_PROVIDER=fake            # fake | openai | ollama
OPENAI_API_KEY=              # required for openai
LLM_MODEL=                   # optional model id override
LLM_BASE_URL=                # optional (OpenAI-compatible endpoint, or Ollama URL e.g. http://localhost:11434)

EXECUTION_ENABLED=true       # false: write projects but never build/test them
EXECUTION_REQUIRE_APPROVAL=true  # human approval before generated code is executed
MAX_CORRECTION_ATTEMPTS=2
WORKSPACE_ROOT=./workspaces
MAVEN_COMMAND=mvn

# Optional PostgreSQL (see compose.yaml); default is a local H2 file database
# DB_URL=jdbc:postgresql://localhost:5432/minimetagpt
# DB_USER=minimetagpt
# DB_PASSWORD=minimetagpt

# Optional OpenTelemetry export (see compose.yaml collector)
# OTEL_TRACES_EXPORT_ENABLED=true
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
